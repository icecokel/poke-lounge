{
  "name": "@poke-lounge/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname localhost",
    "build": "node ../../scripts/poke-lounge/check-asset-provenance.mjs --deployment-gate && next build",
    "start": "next start",
    "lint": "eslint .",
    "type:check": "tsc --noEmit",
    "test:poke-lounge-unit": "node scripts/web-unit-test-runner.mjs",
    "generate:types": "openapi-typescript ../api/openapi.json -o src/types/api.d.ts",
    "e2e": "node scripts/playwright-runner.mjs test",
    "e2e:integration": "node scripts/playwright-integration-runner.mjs",
    "e2e:five-player": "node scripts/playwright-integration-runner.mjs tests/e2e/poke-lounge-five-player-tournament.spec.ts --project=poke-lounge-five-browser-integration",
    "e2e:local-test-mode": "node scripts/playwright-runner.mjs --local-test-mode test tests/e2e/poke-lounge-local-test-mode.spec.ts --project=chromium",
    "e2e:server": "NEXT_DIST_DIR=.next-e2e PLAYWRIGHT_PORT=37123 node scripts/playwright-web-server.mjs"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.16",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-slot": "^1.2.5",
    "@poke-lounge/battle": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "^15.5.19",
    "next-auth": "^5.0.0-beta.30",
    "next-intl": "^4.13.0",
    "phaser": "^3.90.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "eslint": "^9.39.4",
    "eslint-config-next": "15.5.19",
    "openapi-typescript": "^7.10.1",
    "postcss": "^8.5.15",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
