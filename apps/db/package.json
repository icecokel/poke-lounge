{
  "name": "@poke-lounge/db",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "PostgreSQL schema migrations and ROM data import for the Rust game server. Not a running service.",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "lint": "eslint \"{src,scripts}/**/*.ts\"",
    "migration:create": "typeorm migration:create",
    "migration:show": "typeorm -d dist/src/data-source.js migration:show",
    "migration:run": "typeorm -d dist/src/data-source.js migration:run",
    "migration:revert": "typeorm -d dist/src/data-source.js migration:revert",
    "rom-data:check": "pnpm --filter @poke-lounge/battle build && ts-node scripts/import-poke-lounge-rom-data.ts --check",
    "rom-data:import": "node dist/scripts/import-poke-lounge-rom-data.js"
  },
  "dependencies": {
    "@poke-lounge/battle": "workspace:*",
    "pg": "^8.17.2",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
