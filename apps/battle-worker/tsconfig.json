{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist",
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "paths": {
      "@poke-lounge/battle/*": ["../../packages/poke-lounge-battle/dist/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
