[package]
name = "poke-lounge-api-rust"
version = "0.1.0"
edition.workspace = true
rust-version.workspace = true
publish.workspace = true

[lints]
workspace = true

[dependencies]
axum = { version = "0.8.9", features = ["json", "ws"] }
redis = { version = "1.7.0", default-features = false, features = ["tokio-comp", "connection-manager", "script"] }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
sha2 = "0.10"
subtle = "2.6"
thiserror = "2.0"
tokio = { version = "1", features = ["macros", "rt-multi-thread", "net", "signal", "sync", "time"] }
tokio-util = { version = "0.7", features = ["rt"] }
tower-http = { version = "0.6", features = ["cors", "request-id", "sensitive-headers"] }
tracing = "0.1"
tracing-subscriber = { version = "0.3", features = ["env-filter", "json"] }
uuid = { version = "1", features = ["v4", "serde"] }

reqwest = { version = "0.12", default-features = false, features = ["json"] }
futures-util = "0.3"
tokio-postgres = { version = "0.7", features = ["with-serde_json-1", "with-uuid-1"] }
