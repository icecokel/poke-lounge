# Native invocation reference only. For isolated local setup use: pnpm dev:rust
RUST_API_BIND_ADDR=127.0.0.1:3011
RUST_API_REDIS_URL=redis://127.0.0.1:36379/0
BATTLE_WORKER_URL=http://127.0.0.1:3021
# Must match the private compute service; never expose it as NEXT_PUBLIC_*.
BATTLE_WORKER_TOKEN=
DB_HOST=127.0.0.1
DB_PORT=35432
DB_USERNAME=poke_rust_local
DB_DATABASE=poke_rust_local
DB_PASSWORD=
CORS_ORIGINS=http://localhost:3300,http://127.0.0.1:3300
RUST_LOG=info
