NODE_ENV=development
PORT=3001
LOG_LEVEL=

# Add the deployed Web origin explicitly in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

GOOGLE_CLIENT_ID=replace-with-google-client-id

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace-with-db-password
DB_DATABASE=poke_lounge
DB_SYNCHRONIZE=false

# Required: room state, player state, Socket.IO fan-out, and BullMQ turns.
REDIS_URL=redis://localhost:6379

# Optional production error notification endpoint.
NOTIFY_SERVICE_URL=
NOTIFY_SERVICE_USER=
NOTIFY_SERVICE_PASSWORD=

# Development-only auth bypasses. Never enable in production.
ENABLE_DEV_AUTH_BYPASS=false
DEV_AUTH_TOKEN=
LOCAL_TEST_AUTH_TOKEN=

