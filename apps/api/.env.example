NODE_ENV=development
PORT=3001
LOG_LEVEL=

# Add the deployed Web origin explicitly in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace-with-db-password
DB_DATABASE=poke_lounge
DB_SYNCHRONIZE=false

# Required: room state, player state, Socket.IO fan-out, and BullMQ turns.
REDIS_URL=redis://localhost:6379

# Optional production error notification endpoint.
NOTIFY_SERVICE_URL=
NOTIFY_SERVICE_USER=
NOTIFY_SERVICE_PASSWORD=

# Optional development-only local test account. Normal play needs no authentication.
LOCAL_TEST_AUTH_TOKEN=
